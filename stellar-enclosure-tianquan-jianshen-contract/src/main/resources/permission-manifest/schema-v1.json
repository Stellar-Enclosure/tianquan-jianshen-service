{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stellar-enclosure:permission-manifest:1.0",
  "title": "Permission Manifest 1.0",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "application": {
      "type": "object",
      "properties": {
        "businessCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "applicationCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "businessCode",
        "applicationCode"
      ],
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "kind": {
          "enum": [
            "JAVA",
            "REACT_TYPESCRIPT"
          ]
        },
        "snapshotMode": {
          "enum": [
            "FULL",
            "PARTIAL"
          ]
        },
        "ownedKeyPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "expectedModules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "scannedModules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "clearIntent": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "id",
        "kind",
        "snapshotMode",
        "ownedKeyPrefixes",
        "expectedModules",
        "scannedModules"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "buildId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "repository",
        "commit",
        "buildId",
        "version"
      ],
      "additionalProperties": false
    },
    "permissionDefinitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "i18n": {
            "$ref": "#/$defs/i18n"
          },
          "lifecycle": {
            "anyOf": [
              {
                "enum": [
                  "ACTIVE",
                  "DEPRECATED"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "meaning",
          "i18n"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "permissionReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "resourceReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "usage": {
            "enum": [
              "FORM_FIELD",
              "TABLE_FIELD",
              "DETAIL_FIELD",
              "CALLS",
              "PARENT",
              "COMPONENT"
            ]
          }
        },
        "required": [
          "key",
          "usage"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/message"
      },
      "minItems": 0,
      "maxItems": 20000,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "application",
    "producer",
    "artifact",
    "permissionDefinitions",
    "permissionReferences",
    "resources",
    "resourceReferences",
    "messages"
  ],
  "additionalProperties": false,
  "$defs": {
    "simpleRequirement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "ALL",
                "ANY"
              ]
            },
            "codes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true
            }
          },
          "required": [
            "mode",
            "codes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "access": {
              "const": "PUBLIC"
            }
          },
          "required": [
            "access"
          ],
          "additionalProperties": false
        }
      ]
    },
    "requirement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "ALL",
                "ANY"
              ]
            },
            "codes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true
            }
          },
          "required": [
            "mode",
            "codes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "access": {
              "const": "PUBLIC"
            }
          },
          "required": [
            "access"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "allOf": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/simpleRequirement"
              },
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true
            }
          },
          "required": [
            "allOf"
          ],
          "additionalProperties": false
        }
      ]
    },
    "i18n": {
      "type": "object",
      "properties": {
        "pageCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "not": {
            "pattern": "(^|\\.)(__proto__|constructor|prototype)(\\.|$)"
          }
        },
        "labelKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "not": {
            "pattern": "(^|\\.)(__proto__|constructor|prototype)(\\.|$)"
          }
        },
        "descriptionKey": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
              "not": {
                "pattern": "(^|\\.)(__proto__|constructor|prototype)(\\.|$)"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "helpKey": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
              "not": {
                "pattern": "(^|\\.)(__proto__|constructor|prototype)(\\.|$)"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "placeholderKey": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
              "not": {
                "pattern": "(^|\\.)(__proto__|constructor|prototype)(\\.|$)"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "validationKey": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
              "not": {
                "pattern": "(^|\\.)(__proto__|constructor|prototype)(\\.|$)"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pageCode",
        "labelKey"
      ],
      "additionalProperties": false
    },
    "fieldPolicy": {
      "type": "object",
      "properties": {
        "valueType": {
          "enum": [
            "STRING",
            "NUMBER",
            "BOOLEAN",
            "OBJECT",
            "ARRAY"
          ]
        },
        "plainRead": {
          "anyOf": [
            {
              "$ref": "#/$defs/requirement"
            },
            {
              "type": "null"
            }
          ]
        },
        "maskedRead": {
          "anyOf": [
            {
              "$ref": "#/$defs/requirement"
            },
            {
              "type": "null"
            }
          ]
        },
        "write": {
          "anyOf": [
            {
              "$ref": "#/$defs/requirement"
            },
            {
              "type": "null"
            }
          ]
        },
        "masker": {
          "anyOf": [
            {
              "enum": [
                "FIXED",
                "EMAIL",
                "PHONE",
                "BANK_ACCOUNT"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "valueType"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "maskedRead"
            ],
            "properties": {
              "maskedRead": {
                "type": "object"
              }
            }
          },
          "then": {
            "required": [
              "masker"
            ],
            "properties": {
              "valueType": {
                "const": "STRING"
              },
              "masker": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "masker"
            ],
            "properties": {
              "masker": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "maskedRead"
            ],
            "properties": {
              "maskedRead": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "resource": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "type": {
          "enum": [
            "APP",
            "MENU",
            "PAGE",
            "COMPONENT",
            "BUTTON",
            "API",
            "FIELD"
          ]
        },
        "target": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }
            ]
          }
        },
        "access": {
          "anyOf": [
            {
              "enum": [
                "PROTECTED",
                "PUBLIC",
                "INTERNAL"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "requirement": {
          "anyOf": [
            {
              "$ref": "#/$defs/requirement"
            },
            {
              "type": "null"
            }
          ]
        },
        "fieldPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/fieldPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowedPrincipals": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "enum": [
                  "USER",
                  "SERVICE"
                ]
              },
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "oauthScopes": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              "minItems": 0,
              "maxItems": 64,
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "i18n": {
          "$ref": "#/$defs/i18n"
        },
        "lifecycle": {
          "anyOf": [
            {
              "enum": [
                "ACTIVE",
                "DEPRECATED"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "type",
        "target",
        "i18n"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "access"
            ],
            "properties": {
              "access": {
                "enum": [
                  "PUBLIC",
                  "INTERNAL"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "requirement": {
                "type": "null"
              },
              "fieldPolicy": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "FIELD"
              }
            },
            "not": {
              "required": [
                "access"
              ],
              "properties": {
                "access": {
                  "enum": [
                    "PUBLIC",
                    "INTERNAL"
                  ]
                }
              }
            }
          },
          "then": {
            "required": [
              "fieldPolicy"
            ],
            "properties": {
              "fieldPolicy": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "const": "FIELD"
                }
              }
            }
          },
          "then": {
            "properties": {
              "fieldPolicy": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "message": {
      "type": "object",
      "properties": {
        "pageCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "not": {
            "pattern": "(^|\\.)(__proto__|constructor|prototype)(\\.|$)"
          }
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
          "not": {
            "pattern": "(^|\\.)(__proto__|constructor|prototype)(\\.|$)"
          }
        },
        "defaultLocale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
          "maxLength": 64,
          "x-canonicalBcp47": true
        },
        "defaults": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "not": {
              "pattern": "\u0000"
            },
            "x-tianshuInterpolation": true
          }
        }
      },
      "required": [
        "pageCode",
        "key",
        "defaultLocale",
        "defaults"
      ],
      "additionalProperties": false
    }
  },
  "x-contract": {
    "maxUtf8Bytes": 16777216,
    "maxDepth": 16,
    "canonical": "sorted ASCII object keys; sorted unique sets; integral safe JSON numbers; well-formed Unicode; IDs and revisions are decimal strings",
    "semanticChecks": [
      "full module coverage",
      "case-only collisions",
      "ownership prefixes",
      "local permission definition/reference closure",
      "field masker output type",
      "default locale presence",
      "explicit empty-producer intent",
      "target scope and cross-producer reference closure at registration/activation"
    ]
  }
}
